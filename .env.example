# Fake values only. The library never reads these: the consuming service loads them into logging.Config.
LOGGER_HOST=http://localhost
LOGGER_PORT=3000
LOGGER_PATH=/logs
LOGGER_CONSOLE_ENABLED=true
LOGGER_HTTP_ENABLED=false
LOGGER_MASK_EXTRA_PATTERNS=

# AWS HTTP sink: adapts every entry to POST /api/v1/cloudwatch/logs/add of aws_microservice (CloudWatch Logs).
LOGGER_AWS_HTTP_ENABLED=false
LOGGER_AWS_HTTP_HOST=http://localhost
LOGGER_AWS_HTTP_PORT=8080
LOGGER_AWS_HTTP_PATH=/api/v1/cloudwatch/logs/add
LOGGER_AWS_HTTP_LOG_GROUP=
LOGGER_AWS_HTTP_LOG_STREAM=

# Core configuration of the new standard (T-03.6). Fake values only. The library never reads these: the consumer loads them into its own configuration and passes them in.
TELEMETRY_SERVICE_NAME=sensor-hub
TELEMETRY_INSTANCE_ID=
TELEMETRY_ENVIRONMENT=
TELEMETRY_SERVICE_VERSION=
TELEMETRY_HOST=
TELEMETRY_TIME_ZONE=
TELEMETRY_DELIVERY_MODE=best_effort
TELEMETRY_QUEUE_SIZE=10000
TELEMETRY_BATCH_SIZE=100
TELEMETRY_FLUSH_INTERVAL_MS=2000
TELEMETRY_TIMEOUT_MS=3000
TELEMETRY_MAX_ATTRIBUTE_KEYS=32
TELEMETRY_MAX_ATTRIBUTE_KEY_CHARS=64
TELEMETRY_MAX_ATTRIBUTE_VALUE_CHARS=256
TELEMETRY_MAX_EVENT_BYTES=65536
TELEMETRY_MAX_BATCH_BYTES=1048576
TELEMETRY_SPOOL_DIRECTORY=
TELEMETRY_SPOOL_QUOTA_BYTES=268435456
TELEMETRY_MASK_EXTRA_PATTERNS=
# TELEMETRY_MASK_FIELD_NAMES=  (leave it commented unless you mean to REPLACE the default list: an empty value is a set empty list)
TELEMETRY_MASK_EXTRA_FIELD_NAMES=
TELEMETRY_MASK_FIELD_CLASSES=
TELEMETRY_MASK_CLASS_RULES=

# ----- the settings of each adapter start here: each block has its own schema in contracts/config/ and its own test; the tests of the core configuration stop reading at this line -----

# Shared HTTP client of the new standard (T-04.4). Fake values only: put real tokens in the secret store of the deployment, never here. The library never reads these.
TELEMETRY_HTTP_URL=https://logs.example.invalid/ingest
TELEMETRY_HTTP_METHOD=POST
TELEMETRY_HTTP_TIMEOUT_MS=3000
TELEMETRY_HTTP_COMPRESS=false
# TELEMETRY_HTTP_SKIP_TLS_VERIFICATION=false  (leave it unset: true turns the TLS verification off)
TELEMETRY_HTTP_BEARER_TOKEN=
TELEMETRY_HTTP_API_KEY_HEADER=
TELEMETRY_HTTP_API_KEY_VALUE=
TELEMETRY_HTTP_MAX_ATTEMPTS=5
TELEMETRY_HTTP_RETRY_BASE_DELAY_MS=200
TELEMETRY_HTTP_RETRY_MAX_DELAY_MS=30000

# Console destination of the new standard (T-04.2). Fake values only. The library never reads these.
TELEMETRY_CONSOLE_FORMAT=json
TELEMETRY_CONSOLE_MINIMUM_SEVERITY=INFO

# File destination of the new standard (T-04.3). Fake values only. The library never reads these.
TELEMETRY_FILE_DIRECTORY=logs
TELEMETRY_FILE_NAME=telemetry.jsonl
TELEMETRY_FILE_MINIMUM_SEVERITY=INFO
TELEMETRY_FILE_MAX_FILE_BYTES=10485760
TELEMETRY_FILE_MAX_FILES=5
TELEMETRY_FILE_QUOTA_BYTES=52428800

# HTTP destination of the new standard (T-04.5): the shared client above plus this one. Fake values only. The library never reads these.
TELEMETRY_HTTP_MINIMUM_SEVERITY=INFO
