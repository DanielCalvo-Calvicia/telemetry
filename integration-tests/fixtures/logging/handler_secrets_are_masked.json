{
  "description": "The handler goes through the same chain, so a secret attribute is masked.",
  "kind": "handler",
  "config": {
    "profile": "microservice",
    "overrides": {
      "resource": {
        "service_name": "sensor-hub",
        "instance_id": "hub-01"
      }
    }
  },
  "clock": {
    "wall_time": "2026-10-28T10:00:00.123456+00:00"
  },
  "event_ids": [
    "01900000-0000-7000-8000-000000000001"
  ],
  "sinks": {
    "log": [
      {}
    ]
  },
  "default_category": "app",
  "records": [
    {
      "go_level": 8,
      "python_level": 40,
      "message": "failed",
      "attrs": {
        "token": "abc",
        "user": "bob"
      }
    }
  ],
  "expected": {
    "deliveries": {
      "log": [
        [
          "{\"attributes\":{\"token\":\"*****MASKED*****\",\"user\":\"bob\"},\"data\":{\"category\":\"app\",\"message\":\"failed\"},\"event_id\":\"01900000-0000-7000-8000-000000000001\",\"event_type\":\"log.entry.recorded\",\"occurred_at\":\"2026-10-28T10:00:00.123456Z\",\"recorded_at\":\"2026-10-28T10:00:00.123456Z\",\"resource\":{\"instance_id\":\"hub-01\",\"service_name\":\"sensor-hub\"},\"schema_version\":\"0.1\",\"severity\":\"ERROR\"}"
        ]
      ]
    }
  }
}
