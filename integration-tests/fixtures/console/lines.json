{
  "description": "The output of the console destination for a list of events given to one Send: the exact bytes written and the result (each event counted once: a filtered event counts as accepted).",
  "cases": [
    {
      "name": "json_one_event",
      "description": "The JSON format writes the canonical JSON of the envelope and a line feed: the same bytes in both languages.",
      "format": "json",
      "events": [
        {
          "schema_version": "0.1",
          "event_id": "01900000-0000-7000-8000-000000000001",
          "event_type": "log.entry.recorded",
          "occurred_at": "2026-10-28T10:00:00.123456Z",
          "recorded_at": "2026-10-28T10:00:00.123456Z",
          "severity": "INFO",
          "resource": {
            "service_name": "sensor-hub",
            "instance_id": "hub-01"
          },
          "data": {
            "category": "http",
            "message": "started"
          }
        }
      ],
      "expected_output": "{\"data\":{\"category\":\"http\",\"message\":\"started\"},\"event_id\":\"01900000-0000-7000-8000-000000000001\",\"event_type\":\"log.entry.recorded\",\"occurred_at\":\"2026-10-28T10:00:00.123456Z\",\"recorded_at\":\"2026-10-28T10:00:00.123456Z\",\"resource\":{\"instance_id\":\"hub-01\",\"service_name\":\"sensor-hub\"},\"schema_version\":\"0.1\",\"severity\":\"INFO\"}\n",
      "expected_result": {
        "accepted": 1,
        "dropped": 0,
        "failed": 0
      }
    },
    {
      "name": "json_two_events_non_ascii",
      "description": "One line per event, in order; characters outside ASCII and outside the BMP are kept.",
      "format": "json",
      "events": [
        {
          "schema_version": "0.1",
          "event_id": "01900000-0000-7000-8000-000000000001",
          "event_type": "log.entry.recorded",
          "occurred_at": "2026-10-28T10:00:00.123456Z",
          "recorded_at": "2026-10-28T10:00:00.123456Z",
          "severity": "INFO",
          "resource": {
            "service_name": "sensor-hub",
            "instance_id": "hub-01"
          },
          "data": {
            "category": "señal",
            "message": "température 😀"
          }
        },
        {
          "schema_version": "0.1",
          "event_id": "01900000-0000-7000-8000-000000000002",
          "event_type": "log.entry.recorded",
          "occurred_at": "2026-10-28T10:00:00.123456Z",
          "recorded_at": "2026-10-28T10:00:00.123456Z",
          "severity": "WARN",
          "resource": {
            "service_name": "sensor-hub",
            "instance_id": "hub-01"
          },
          "data": {
            "category": "http",
            "message": "slow",
            "function": "serve"
          },
          "attributes": {
            "order": 7,
            "ok": true
          }
        }
      ],
      "expected_output": "{\"data\":{\"category\":\"señal\",\"message\":\"température 😀\"},\"event_id\":\"01900000-0000-7000-8000-000000000001\",\"event_type\":\"log.entry.recorded\",\"occurred_at\":\"2026-10-28T10:00:00.123456Z\",\"recorded_at\":\"2026-10-28T10:00:00.123456Z\",\"resource\":{\"instance_id\":\"hub-01\",\"service_name\":\"sensor-hub\"},\"schema_version\":\"0.1\",\"severity\":\"INFO\"}\n{\"attributes\":{\"ok\":true,\"order\":7},\"data\":{\"category\":\"http\",\"function\":\"serve\",\"message\":\"slow\"},\"event_id\":\"01900000-0000-7000-8000-000000000002\",\"event_type\":\"log.entry.recorded\",\"occurred_at\":\"2026-10-28T10:00:00.123456Z\",\"recorded_at\":\"2026-10-28T10:00:00.123456Z\",\"resource\":{\"instance_id\":\"hub-01\",\"service_name\":\"sensor-hub\"},\"schema_version\":\"0.1\",\"severity\":\"WARN\"}\n",
      "expected_result": {
        "accepted": 2,
        "dropped": 0,
        "failed": 0
      }
    },
    {
      "name": "text_basic",
      "description": "The readable line: the time, the severity padded to 8, the category in brackets and the message.",
      "format": "text",
      "events": [
        {
          "schema_version": "0.1",
          "event_id": "01900000-0000-7000-8000-000000000001",
          "event_type": "log.entry.recorded",
          "occurred_at": "2026-10-28T10:00:00.123456Z",
          "recorded_at": "2026-10-28T10:00:00.123456Z",
          "severity": "INFO",
          "resource": {
            "service_name": "sensor-hub",
            "instance_id": "hub-01"
          },
          "data": {
            "category": "http",
            "message": "started"
          }
        }
      ],
      "expected_output": "2026-10-28T10:00:00.123456Z INFO     [http] started\n",
      "expected_result": {
        "accepted": 1,
        "dropped": 0,
        "failed": 0
      }
    },
    {
      "name": "text_function_and_attributes",
      "description": "With a function the line shows 'function:'; the attributes follow sorted by key, each value in its JSON form (a string is quoted, a list is kept).",
      "format": "text",
      "events": [
        {
          "schema_version": "0.1",
          "event_id": "01900000-0000-7000-8000-000000000001",
          "event_type": "log.entry.recorded",
          "occurred_at": "2026-10-28T10:00:00.123456Z",
          "recorded_at": "2026-10-28T10:00:00.123456Z",
          "severity": "WARN",
          "resource": {
            "service_name": "sensor-hub",
            "instance_id": "hub-01"
          },
          "data": {
            "category": "http",
            "message": "request done",
            "function": "serve"
          },
          "attributes": {
            "tags": [
              "a",
              "b"
            ],
            "order": 7,
            "ok": true,
            "name": "bob",
            "note": "say \"hi\"",
            "ratio": 0.5
          }
        }
      ],
      "expected_output": "2026-10-28T10:00:00.123456Z WARN     [http] serve: request done name=\"bob\" note=\"say \\\"hi\\\"\" ok=true order=7 ratio=0.5 tags=[\"a\",\"b\"]\n",
      "expected_result": {
        "accepted": 1,
        "dropped": 0,
        "failed": 0
      }
    },
    {
      "name": "text_control_characters_are_escaped",
      "description": "A line break, a carriage return, a tab, the escape character or any control character in the category, the function, the message or an attribute key never splits or colors the line: it is written as an escape.",
      "format": "text",
      "events": [
        {
          "schema_version": "0.1",
          "event_id": "01900000-0000-7000-8000-000000000001",
          "event_type": "log.entry.recorded",
          "occurred_at": "2026-10-28T10:00:00.123456Z",
          "recorded_at": "2026-10-28T10:00:00.123456Z",
          "severity": "ERROR",
          "resource": {
            "service_name": "sensor-hub",
            "instance_id": "hub-01"
          },
          "data": {
            "category": "ht\ntp",
            "message": "line1\nline2\r\u001b[31mred\tend",
            "function": "se\nrve"
          },
          "attributes": {
            "k\ney": "v\nw"
          }
        }
      ],
      "expected_output": "2026-10-28T10:00:00.123456Z ERROR    [ht\\ntp] se\\nrve: line1\\nline2\\r\\u001b[31mred\\t\\u007fend k\\ney=\"v\\nw\"\n",
      "expected_result": {
        "accepted": 1,
        "dropped": 0,
        "failed": 0
      }
    },
    {
      "name": "text_non_ascii",
      "description": "Characters outside ASCII are kept in the readable line.",
      "format": "text",
      "events": [
