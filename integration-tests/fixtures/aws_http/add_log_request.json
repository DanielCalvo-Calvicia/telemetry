      "expected_request": "{\"log_group_name\":\"my-log-group\",\"log_stream_name\":\"my-log-stream\",\"message\":\"{\\\"ProducerID\\\":\\\"sensor-hub\\\",\\\"ApplicationID\\\":\\\"hub-01\\\",\\\"ProcessID\\\":\\\"\\\",\\\"Application\\\":\\\"sensor-hub\\\",\\\"Category\\\":\\\"t\\\",\\\"Function\\\":\\\"\\\",\\\"Indentation\\\":0,\\\"Depth\\\":0,\\\"Level\\\":\\\"DEBUG\\\",\\\"Message\\\":\\\"m\\\",\\\"Fields\\\":null,\\\"Timestamp\\\":\\\"2026-10-28T10:00:00.999999Z\\\"}\",\"timestamp\":1793181600999}",
      "expected_message": "{\"ProducerID\":\"sensor-hub\",\"ApplicationID\":\"hub-01\",\"ProcessID\":\"\",\"Application\":\"sensor-hub\",\"Category\":\"t\",\"Function\":\"\",\"Indentation\":0,\"Depth\":0,\"Level\":\"DEBUG\",\"Message\":\"m\",\"Fields\":null,\"Timestamp\":\"2026-10-28T10:00:00.999999Z\"}"
    },
