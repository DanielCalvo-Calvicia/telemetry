      "expected_message": "{\"ProducerID\":\"sensor-hub\",\"ApplicationID\":\"hub-01\",\"ProcessID\":\"\",\"Application\":\"sensor-hub\",\"Category\":\"t\",\"Function\":\"\",\"Indentation\":0,\"Depth\":0,\"Level\":\"TRACE\",\"Message\":\"\",\"Fields\":null,\"Timestamp\":\"2026-10-28T10:00:00.123456Z\"}"
