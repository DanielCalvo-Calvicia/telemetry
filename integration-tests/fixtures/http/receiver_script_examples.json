    {
      "description": "A 429 can carry a Retry-After header.",
      "config": {},
      "script": [
        {
          "status": 429,
          "retry_after": "5"
        }
      ],
      "requests": [
        {
          "body": "{\"events\":[{\"data\":{\"category\":\"http\",\"message\":\"one\"},\"event_id\":\"01900000-0000-7000-8000-000000000001\",\"event_type\":\"log.entry.recorded\",\"occurred_at\":\"2026-10-28T10:00:00.123456Z\",\"recorded_at\":\"2026-10-28T10:00:00.123456Z\",\"resource\":{\"instance_id\":\"hub-01\",\"service_name\":\"sensor-hub\"},\"schema_version\":\"0.1\",\"severity\":\"INFO\"},{\"data\":{\"category\":\"http\",\"message\":\"two\"},\"event_id\":\"01900000-0000-7000-8000-000000000002\",\"event_type\":\"log.entry.recorded\",\"occurred_at\":\"2026-10-28T10:00:00.123456Z\",\"recorded_at\":\"2026-10-28T10:00:00.123456Z\",\"resource\":{\"instance_id\":\"hub-01\",\"service_name\":\"sensor-hub\"},\"schema_version\":\"0.1\",\"severity\":\"INFO\"}],\"schema_version\":\"0.1\"}"
        }
      ],
      "expected": [
        {
          "status": 429,
          "headers": {
            "Retry-After": "5"
          }
        }
      ],
      "expected_recorded": {
        "requests": 1,
        "events": 2,
        "invalid": []
      }
    },
    {
      "description": "A redirect carries its Location header; the fake never follows or serves it.",
