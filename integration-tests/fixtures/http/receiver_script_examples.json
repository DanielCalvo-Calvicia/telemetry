    {
      "description": "A body that is not the batch of REQ-OUT-010 is rejected with 400 and the reason; the fake records the request and the reason.",
      "config": {},
      "script": [],
      "requests": [
        {
          "body": "{\"events\":[{\"data\":{\"category\":\"http\",\"message\":\"one\"},\"event_id\":\"01900000-0000-7000-8000-000000000001\",\"event_type\":\"log.entry.recorded\",\"occurred_at\":\"2026-10-28T10:00:00.123456Z\",\"recorded_at\":\"2026-10-28T10:00:00.123456Z\",\"resource\":{\"instance_id\":\"hub-01\",\"service_name\":\"sensor-hub\"},\"schema_version\":\"0.1\",\"severity\":\"INFO\"}]}"
        }
      ],
      "expected": [
        {
          "status": 400,
          "body_contains": "schema_version"
        }
      ],
      "expected_recorded": {
        "requests": 1,
        "events": 0,
        "invalid": [
          "schema_version"
        ]
      }
    },
    {
      "description": "A body that is not JSON is rejected with 400.",
