{
  "description": "The settings of the shared HTTP client: the effective settings (the defaults, then the given ones) as exact canonical JSON, or the problems, each with its field and code, in the order of the schema (contracts/config/http_client.schema.json). A secret is never in a message.",
  "cases": [
    {
      "description": "the minimum: an https url",
      "settings": {
        "url": "https://logs.example.invalid/ingest"
      },
      "expected": "{\"api_key_header\":\"\",\"api_key_value\":\"\",\"bearer_token\":\"\",\"compress\":false,\"max_attempts\":5,\"method\":\"POST\",\"retry_base_delay_ms\":200,\"retry_max_delay_ms\":30000,\"skip_tls_verification\":false,\"timeout_ms\":3000,\"url\":\"https://logs.example.invalid/ingest\"}"
    },
    {
      "description": "a bearer token over https",
      "settings": {
        "url": "https://logs.example.invalid/ingest",
        "bearer_token": "tok.en-1_2"
      },
      "expected": "{\"api_key_header\":\"\",\"api_key_value\":\"\",\"bearer_token\":\"tok.en-1_2\",\"compress\":false,\"max_attempts\":5,\"method\":\"POST\",\"retry_base_delay_ms\":200,\"retry_max_delay_ms\":30000,\"skip_tls_verification\":false,\"timeout_ms\":3000,\"url\":\"https://logs.example.invalid/ingest\"}"
    },
    {
      "description": "an API key over plain http to localhost",
      "settings": {
        "url": "http://localhost:3000/logs",
        "api_key_header": "X-Api-Key",
        "api_key_value": "k3y"
      },
      "expected": "{\"api_key_header\":\"X-Api-Key\",\"api_key_value\":\"k3y\",\"bearer_token\":\"\",\"compress\":false,\"max_attempts\":5,\"method\":\"POST\",\"retry_base_delay_ms\":200,\"retry_max_delay_ms\":30000,\"skip_tls_verification\":false,\"timeout_ms\":3000,\"url\":\"http://localhost:3000/logs\"}"
    },
    {
      "description": "plain http without authentication",
      "settings": {
        "url": "http://logs.example.invalid/ingest"
      },
      "expected": "{\"api_key_header\":\"\",\"api_key_value\":\"\",\"bearer_token\":\"\",\"compress\":false,\"max_attempts\":5,\"method\":\"POST\",\"retry_base_delay_ms\":200,\"retry_max_delay_ms\":30000,\"skip_tls_verification\":false,\"timeout_ms\":3000,\"url\":\"http://logs.example.invalid/ingest\"}"
    },
    {
      "description": "every field set",
      "settings": {
        "url": "https://logs.example.invalid/ingest",
        "method": "PUT",
        "timeout_ms": 1500,
        "compress": true,
        "skip_tls_verification": true,
        "api_key_header": "X-Api-Key",
        "api_key_value": "k3y",
        "max_attempts": 3,
        "retry_base_delay_ms": 100,
        "retry_max_delay_ms": 5000
      },
      "expected": "{\"api_key_header\":\"X-Api-Key\",\"api_key_value\":\"k3y\",\"bearer_token\":\"\",\"compress\":true,\"max_attempts\":3,\"method\":\"PUT\",\"retry_base_delay_ms\":100,\"retry_max_delay_ms\":5000,\"skip_tls_verification\":true,\"timeout_ms\":1500,\"url\":\"https://logs.example.invalid/ingest\"}"
    },
    {
      "description": "no url (the library fixes none)",
      "settings": {},
      "problems": [
        {
          "field": "url",
          "code": "config_field_invalid"
        }
      ]
    },
    {
      "description": "a scheme that is not http or https",
      "settings": {
        "url": "ftp://logs.example.invalid/x"
      },
      "problems": [
        {
          "field": "url",
          "code": "config_field_invalid"
        }
      ]
    },
    {
      "description": "a url without host",
      "settings": {
        "url": "https:///path"
      },
      "problems": [
        {
          "field": "url",
          "code": "config_field_invalid"
        }
      ]
    },
    {
