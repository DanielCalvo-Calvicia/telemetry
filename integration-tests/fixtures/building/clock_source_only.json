{
  "description": "A clock that knows its source but not whether it is synced adds clock_source only: an unknown flag is absent, never false.",
  "kind": "build",
  "setup": {
    "wall_time": "2026-10-28T10:00:00.123456+00:00",
    "event_id": "01900000-0000-7000-8000-000000000001",
    "resource": {
      "service_name": "sensor-hub",
      "instance_id": "hub-01"
    },
    "clock_info": {
      "source": "rtc"
    }
  },
  "input": {
    "event_type": "log.entry.recorded",
    "severity": "INFO",
    "data": {
      "category": "http",
      "message": "started"
    }
  },
