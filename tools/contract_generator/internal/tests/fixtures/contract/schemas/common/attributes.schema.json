{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telemetry.example/fixture/schemas/common/attributes.schema.json",
  "title": "Attributes",
  "type": "object",
  "maxProperties": 3,
  "propertyNames": { "minLength": 1, "maxLength": 8 },
  "additionalProperties": {
    "anyOf": [{ "$ref": "#/$defs/scalar" }, { "type": "array", "items": { "$ref": "#/$defs/scalar" } }]
  },
  "$defs": {
    "scalar": {
      "anyOf": [{ "type": "string", "maxLength": 10 }, { "type": "number" }, { "type": "boolean" }]
    }
  }
}
